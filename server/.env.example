# Copia este archivo como server/.env y rellénalo. NUNCA subas .env al repositorio.
# Sin estas dos variables, el servidor funciona con jugadores invitados.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Supabase > Project Settings > API Keys > service_role (secreta: solo en el servidor)
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001
CLIENT_ORIGIN=http://localhost:5173
